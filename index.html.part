<div class="chart-wrap">
                    <svg class="chart" viewBox="0 0 320 120" preserveAspectRatio="xMidYMid meet">
                      <defs>
                        <linearGradient id="chartLineGrad" x1="0" y1="1" x2="1" y2="0" gradientUnits="objectBoundingBox">
                          <stop offset="0%" stop-color="#22B8CF"/>
                          <stop offset="50%" stop-color="#3DD5E8"/>
                          <stop offset="100%" stop-color="#6FD3A8"/>
                        </linearGradient>
                        <linearGradient id="chartAreaGrad" x1="0" y1="0" x2="0" y2="1" gradientUnits="objectBoundingBox">
                          <stop offset="0%" stop-color="rgba(34,184,207,.28)"/>
                          <stop offset="100%" stop-color="rgba(111,211,168,.04)"/>
                        </linearGradient>
                        <filter id="lineGlow" x="-50%" y="-50%" width="200%" height="200%">
                          <feGaussianBlur stdDeviation="2" result="blur"/>
                          <feMerge>
                            <feMergeNode in="blur"/>
                            <feMergeNode in="SourceGraphic"/>
                          </feMerge>
                        </filter>
                      </defs>
                      <g class="chart__grid" stroke="#1B3A6B" stroke-opacity=".12" stroke-width="1">
                        <line x1="0" y1="24" x2="320" y2="24"/>
                        <line x1="0" y1="56" x2="320" y2="56"/>
                        <line x1="0" y1="88" x2="320" y2="88"/>
                      </g>
                      <path class="chart__area" d="M0,88 C38,74 58,48 92,58 C126,68 142,30 180,34 C218,38 240,64 320,24 L320,120 L0,120 Z" fill="url(#chartAreaGrad)" transform-origin="50% 100%"/>
                      <path class="chart__line" d="M0,88 C38,74 58,48 92,58 C126,68 142,30 180,34 C218,38 240,64 320,24" fill="none" stroke="url(#chartLineGrad)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="520" stroke-dashoffset="520" filter="url(#lineGlow)"/>
                      <g fill="#0E274A">
                        <circle cx="92" cy="58" r="3.5"/>
                        <circle cx="180" cy="34" r="3.5"/>
                        <circle cx="320" cy="24" r="3.5"/>
                      </g>
                    </svg>
                    </div>